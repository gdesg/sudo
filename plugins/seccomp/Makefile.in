#
# Makefile for sudo seccomp policy plugin.
#

srcdir = @srcdir@
abs_srcdir = @abs_srcdir@
top_srcdir = @top_srcdir@
abs_top_srcdir = @abs_top_srcdir@
builddir = @builddir@
abs_builddir = @abs_builddir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

# So we can find sudo_plugin.h
INCLUDES = -I$(abs_top_srcdir)/include -I$(abs_top_builddir)/include

# Compiler and flags
CC = @CC@
CFLAGS = @CFLAGS@ $(LIBSECCOMP_CFLAGS) $(PIC_FLAG)
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@ @PLUGIN_LDFLAGS@
LIBS = @LIBS@ $(LIBSECCOMP_LIBS)

# Our source code.
SOURCES = $(srcdir)/seccomp_plugin.c

# Plugin may be built as a static or shared object.
#TYPEMAP = $(abs_top_builddir)/type-map
#include $(TYPEMAP)

# The plugin itself.
PLUGIN_NAME = seccomp_plugin
PLUGIN_OBJS = seccomp_plugin.o
ifeq ($(BUILD_SHARED_LIBS), yes)
PLUGIN_SO = $(PLUGIN_NAME).so
else
PLUGIN_SO = $(PLUGIN_NAME).a
endif
PLUGIN = $(PLUGIN_SO)

# Default target.
all: $(PLUGIN)

$(PLUGIN_SO): $(PLUGIN_OBJS)
	$(SUDO_LINK) $(PLUGIN_OBJS) $(LIBS)

# Regression tests
REGRESS_DIR = $(srcdir)/regress
DISALLOWED_PAYLOAD_C = $(REGRESS_DIR)/disallowed_payload.c
DISALLOWED_PAYLOAD_O = disallowed_payload # Compiled in builddir (plugins/seccomp/disallowed_payload)
ALLOWED_PAYLOAD_SH = $(REGRESS_DIR)/allowed_payload.sh

REGRESS_TESTS_C = $(REGRESS_DIR)/seccomp_tests.c
REGRESS_TESTS_O = seccomp_tests # Compiled in builddir (plugins/seccomp/seccomp_tests)

# SUDO_PATH_FOR_TESTS should point to the sudo executable built in the top build directory
SUDO_PATH_FOR_TESTS = $(abs_top_builddir)/src/sudo

# Build test programs
$(DISALLOWED_PAYLOAD_O): $(DISALLOWED_PAYLOAD_C)
	$(CC) $(CFLAGS) $(CPPFLAGS) $(INCLUDES) -o $(abs_builddir)/$(DISALLOWED_PAYLOAD_O) $(DISALLOWED_PAYLOAD_C) $(LDFLAGS) $(LIBS)

$(REGRESS_TESTS_O): $(REGRESS_TESTS_C) $(DISALLOWED_PAYLOAD_O)
	$(CC) $(CFLAGS) $(CPPFLAGS) $(INCLUDES) -DSUDO_PATH_FOR_TESTS='"$(SUDO_PATH_FOR_TESTS)"' -o $(abs_builddir)/$(REGRESS_TESTS_O) $(REGRESS_TESTS_C) $(LDFLAGS) $(LIBS)

check: $(REGRESS_TESTS_O) $(ALLOWED_PAYLOAD_SH)
	@echo "Running seccomp plugin tests from $(abs_builddir)..."
	chmod +x $(ALLOWED_PAYLOAD_SH)
	# Crucial: For these tests to accurately test the plugin, sudo.conf must be configured
	# to load seccomp_plugin.so, and SUDO_PLUGIN_PATH might need to be set if running uninstalled.
	# This is typically handled by a higher-level test harness (e.g., from `make check` in top dir).
	# For now, this will execute the test runner, which tries to call the new sudo.
	cd $(abs_builddir) && ./$(REGRESS_TESTS_O)

# Install the plugin.
install: $(PLUGIN)
	@$(abs_top_srcdir)/scripts/mkinstalldirs $(DESTDIR)$(plugindir)
	$(INSTALL_PROGRAM) $(PLUGIN) $(DESTDIR)$(plugindir)/$(PLUGIN_NAME)@PLUGIN_SUFFIX@

# Uninstall the plugin.
uninstall:
	-rm -f $(DESTDIR)$(plugindir)/$(PLUGIN_NAME)@PLUGIN_SUFFIX@

# Clean up.
clean:
	-rm -f $(PLUGIN_OBJS) $(PLUGIN) core *.core
	-rm -f $(abs_builddir)/$(REGRESS_TESTS_O) $(abs_builddir)/$(DISALLOWED_PAYLOAD_O)
	-rm -f /tmp/seccomp_test_file.txt # Cleanup from allowed_payload.sh or other tests

# Dist clean.
distclean: clean
	-rm -f Makefile

# Maintainer clean.
maintainer-clean: distclean

# Dependencies
dependencies: $(SOURCES)
	$(MAKEDEP) "$(CC) $(CFLAGS) $(CPPFLAGS) $(INCLUDES)" $(SOURCES)

.PHONY: all install uninstall clean distclean maintainer-clean dependencies check
